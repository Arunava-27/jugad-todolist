{
  "name": "jugad-todolist",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev:server": "npm run dev --workspace server",
    "dev:web": "npm run dev --workspace web",
    "build:web": "npm run build --workspace web",
    "start": "npm run start --workspace server",
    "import-notion": "node scripts/import-notion.js",
    "hash-password": "node scripts/hash-password.js",
    "lint": "npm run lint --workspace server && npm run lint --workspace web",
    "test": "npm test --workspace server && npm test --workspace web"
  }
}
