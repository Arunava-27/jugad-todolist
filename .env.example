# Copy this to .env on the server (never commit the real .env)

# Your DuckDNS (or other) domain that points at the droplet's IP, used by Caddy for HTTPS.
DOMAIN=yourname.duckdns.org

# The seeded admin account — created automatically on first boot (or promoted
# to admin if an account with this email already registered). This is the
# only account creation mechanism outside the public Register screen.
ADMIN_EMAIL=arunava@example.com
ADMIN_NAME=Arunava

# Generate with: node scripts/hash-password.js "your-real-password"
# IMPORTANT: docker compose re-expands "$" in .env values when substituting
# them into docker-compose.yml, which corrupts a bcrypt hash's $2a$10$...
# structure. Double every "$" as "$$" here (the hash itself doesn't change,
# only how it's written in this file) — e.g. $2a$10$abc... becomes
# $$2a$$10$$abc...
ADMIN_PASSWORD_HASH=$$2a$$10$$replace-me-with-generated-hash

# Random long string (32+ characters), e.g.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# In production the server refuses to boot without a real value here — see server/src/lib/configCheck.js.
SESSION_SECRET=replace-me-with-a-random-string

# Optional. In production, the API only allows cross-origin requests (with
# cookies) from this exact origin — if left unset, it defaults to your own
# https://$DOMAIN, which is correct for the normal single-app deployment
# above (the browser app and API are always served same-origin, so this
# only matters if some OTHER site needs to call the API directly). Only set
# this if you have a real reason to widen it, e.g. a separate marketing site
# on another domain making authenticated fetches to this API.
CORS_ORIGIN=

# Workspace member invites, email verification, and password reset are all
# emailed via Resend (https://resend.com) — create a free account, verify a
# sending domain (or use their shared onboarding@resend.dev sender for
# testing only), and generate an API key. If RESEND_API_KEY is left unset,
# these still get created but no email is sent — the link is logged
# server-side so you can share/open it by hand instead.
RESEND_API_KEY=
# Must be on a domain you've verified in Resend, e.g. "Punchlist <invites@yourdomain.com>".
EMAIL_FROM=Punchlist <onboarding@resend.dev>
