# Copy this to .env on the server (never commit the real .env)

# Your DuckDNS (or other) domain that points at the droplet's IP, used by Caddy for HTTPS.
DOMAIN=yourname.duckdns.org

# Single admin login for the app.
ADMIN_USERNAME=arunava

# Generate with: node scripts/hash-password.js "your-real-password"
ADMIN_PASSWORD_HASH=$2a$10$replace-me-with-generated-hash

# Random long string, e.g.:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-me-with-a-random-string
